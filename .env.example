# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_NAME=Veluntra
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_USER=veluntra
POSTGRES_PASSWORD=change-me
POSTGRES_DB=veluntra
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- AI assistant ---
# "fake" = a rule-based demo that needs no API key. A real provider is added later.
LLM_PROVIDER=fake
# Safety limits (defaults shown)
# ASSISTANT_MAX_ITERATIONS=5        # max model<->tool round trips per message
# ASSISTANT_HISTORY_MESSAGES=12     # recent messages sent to the model as context

# --- Documents ---
# EMBEDDING_PROVIDER=fake           # offline demo embeddings; a real provider is added later
# DOCUMENT_STORAGE_DIR=storage/documents
# MAX_UPLOAD_BYTES=10485760         # 10 MB
